DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_application_client_id
DISCORD_GUILD_ID=your_server_id

# Channel where buyers post claims (public stock/claims channel)
CLAIMS_CHANNEL_ID=

# Staff-only log channel (no-shows, bans, system events)
STAFF_LOG_CHANNEL_ID=

# Optional: channel where buyers post ban appeals as messages
APPEALS_CHANNEL_ID=

# Role IDs
STAFF_ROLE_ID=
BANNED_ROLE_ID=

# Seller PayID shown after intake form
PAYID=yourname@bank

# Payment deadline in hours (default 2)
PAYMENT_DEADLINE_HOURS=2

# Days after "shipped" before auto-archive (default 7)
ARCHIVE_DAYS_AFTER_SHIPPED=7

# Path to SQLite file
DATABASE_PATH=./data/bot.sqlite
